void main(float3 position : POSITION,
          float4 color : COLOR0,
          uniform float4 camera,
          out float4 clipPosition : POSITION,
          out float4 vertexColor : TEXCOORD0)
{
    // camera = focalX, focalY, eyeHeight, eyeDistance.
    float distance = position.z + camera.w;
    clipPosition = float4(position.x * camera.x,
                          (position.y - camera.z) * camera.y,
                          distance * 1.001001 - 0.1001001,
                          distance);
    vertexColor = color;
}
